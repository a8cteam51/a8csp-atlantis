includes:
    - vendor/a8cteam51/team51-configs/quality-assurance/phpstan.dist.neon

parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    ignoreErrors:
        # phpmd's @SuppressWarnings tag is not valid PHPDoc, so phpstan flags every use of it.
        - '#PHPDoc tag @SuppressWarnings has invalid value#'
        - message: '#should be contravariant with parameter.*?#'
          path: models/Messages_List_Table.php
        # WooCommerce is not a dependency; the call is guarded by is_callable().
        - message: '#Call to static method flush_updates_cache\(\) on an unknown class WC_Helper_Updater#'
          path: src/REST/Force_Update_Check_Controller.php
    excludePaths:
        - src/Modules/Autoupdates/AutoUpdatePluginsFilter.php # too many legacy errors
